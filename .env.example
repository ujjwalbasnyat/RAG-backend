APP_NAME=rag_backend
ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@postgres:5432/rag_db
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rag_chunks

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIM=384

CHUNK_SIZE_DEFAULT=512
CHUNK_OVERLAP_DEFAULT=64
TOP_K_RETRIEVE=10
TOP_K_RERANK=5

CHAT_MEMORY_LIMIT=10
CHAT_MEMORY_TTL=3600
BOOKING_TTL=3600
REQUEST_TIMEOUT_S=60
